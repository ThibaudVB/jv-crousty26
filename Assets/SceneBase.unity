  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Scroll: mouse wheel / Up & Down / right stick\n\n<b>DEVELOPMENT</b>\nThibaud von Borowski\nJordan TCHA\nAntoine BASSET\n\n<b>3D ART & ANIMATION</b>\nEric Tran-Ky\n\n<b>COMMUNICATIONS</b>\nHélène TEA & Mathis Duclos\n\n<b>UI / UX</b>\nEdouard FORT & Eric Tran-Ky\n\n<b>AUDIOVISUAL PRODUCTION</b>\nEric Tran-Ky & Edouard FORT\n\n<b>PROJECT MANAGEMENT</b>\nEdouard FORT, Eric Tran-Ky & Helene TEA\n\n<b>EMOTIONAL SUPPORT</b>\nGwendal Judic & Robin Alonzo\n\n<b>DRINKS SUPPORT</b>\nCathy Duclos\n\n<b>FOOD SUPPORT</b>\nLa Fancy, HFC, Burger King & Super U\n\n<b>SPECIAL THANKS</b>\nGwendal Judic, Arthur Centimètre, Robin Alonzo,\nJulien BERTRAND, GIROUX GUILLAUME,\nHEURARD MAEL\n\n<b>WITH THANKS TO</b>\nBordeaux Montaigne University\nBordeaux Montaigne University Institute of Technology (IUT)\n\n<b>3D ASSET SOURCES</b>\nPoly Pizza — poly.pizza\nSketchfab — sketchfab.com\nThanks to the artists who shared their work.\n\n<b>MUSIC</b>\nWhat We Got — Infraction\n\n<b>SOUND EFFECTS</b>\nHeavy Wings Flapping — Dragon Studio\n\n<b>VISUAL EFFECTS</b>\nCinematic Explosions FREE — Mirza Beig\n\n<b>ENGINE & UI TECHNOLOGY</b>\nUnity & TextMesh Pro\n\nThanks for riding with us!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6a57f33945af343e29f1558f4a2c90f0, type: 2}
  m_sharedMaterial: {fileID: 6862918184447617196, guid: 6a57f33945af343e29f1558f4a2c90f0, type: 2}
